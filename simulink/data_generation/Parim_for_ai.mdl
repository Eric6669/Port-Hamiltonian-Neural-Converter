  <Block BlockType="SubSystem" Name="Vdc ctrl" SID="17739">
    <PortCounts in="1" out="1" enable="1"/>
    <P Name="Position">[400, 379, 485, 481]</P>
    <P Name="ZOrder">-21</P>
