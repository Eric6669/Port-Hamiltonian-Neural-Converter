  <Block BlockType="SubSystem" Name="discrete band pass filter1" SID="17751">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[345, 195, 430, 225]</P>
    <P Name="ZOrder">-23</P>
    <P Name="BackgroundColor">green</P>
    <P Name="NameLocation">top</P>
    <Mask>
      <Type>discrete transfer Fcn generator </Type>
      <Display/>
      <Description>This block transfer a continous TF to a discrete TF 
using Bilinear (Tustin) approximation</Description>
      <Initialization>AD1=tf([1 0],1);

%second order
% Fo=50; %cut off freq.
% omega0=Fo*2*pi;
% adj1=3;   %adjustment 1
Zeta= 0.707*adj1; %Damping factor Zeta ( Q = 1 / (2*Zeta) ):
Wo=2*pi*Fo;
% str=sprintf(&apos; Fo=%iHz\n\n&apos;,Fo);
 n2=0; n1=0;n0=Wo*Wo;
 d2=1;d1=2*Zeta*Wo;d0=Wo*Wo;
numc=[n2 n1 n0];
denc=[d2 d1 d0];
AD3=tf(numc,denc);

AD4=AD1*AD3;
[mag1,pha1]=bode(AD4,Wo);
mag0=mag1;
AD=AD4/mag0;

if bodedw==1
    figure;
    h=bodeplot(AD1,AD3,AD);
    setoptions(h,&apos;FreqUnits&apos;,&apos;Hz&apos;);
    grid on;
    title([&apos;Bode Diagram, adj=&apos;,num2str(adj1)]);
end;
    
% gg=tf(num,den);
ggd=c2d(AD,Ts,&apos;tustin&apos;);
[numd,dend] = tfdata(ggd,&apos;v&apos;);</Initialization>
      <MaskParameter Name="Fo" Type="edit">
        <Prompt>F0 (Hz)</Prompt>
        <Value>frq</Value>
      </MaskParameter>
      <MaskParameter Name="adj1" Type="edit">
        <Prompt>adj (1 for no adjustment, larger adj for wider band pass)</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="inistate" Type="edit">
        <Prompt>Initial states</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="Ts" Type="edit">
        <Prompt>Sample time (must be explicite)</Prompt>
        <Value>Ts</Value>
      </MaskParameter>
      <MaskParameter Name="bodedw" Type="checkbox">
        <Prompt>draw Bode diagram of filter</Prompt>
        <Value>off</Value>
      </MaskParameter>
    </Mask>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">Vabcpu</P>
      </Port>
    </PortProperties>
    <System Ref="system_17751"/>
  </Block>
