  <Block BlockType="SubSystem" Name="Rec_VQcontrol2" SID="18637">
    <PortCounts in="3" out="1"/>
    <P Name="Position">[765, 710, 900, 820]</P>
    <P Name="ZOrder">26563</P>
    <Mask>
      <Type>converter controller</Type>
      <Display IconOpaque="transparent">disp (x);</Display>
      <Description>input 1, 6 dimentions, Vabc, Iabc, (SI)
input 2, 2 dimentions, Pref, Qref (PU)
input 3, 6 dimentions, Vcap at up arm a, lower arm a, up arm b, lower arm b, up arm c and lower arm c.
input 4, 1 dimention, pulse on
input 5, 1 dimention

power or current directions: to go into grid is positive

</Description>
      <Initialization>if cm==0;
    x=[&apos;PQ\nmode&apos;];
else
    x=[&apos;VQ\nmode&apos;];
end

Sb=base(1);            %VA 3phase power base;
Vb=base(2);       %V, line-line rms voltage base
Ib=Sb/(sqrt(3)*Vb); %A, rms current base
Zb=Vb^2/Sb ;        %ohm, impedence base
Vdc=base(3);      %V Vdc+ to ground or ground to Vdc- 
frq=base(4);

if LRx_inpu
    Rxpu=LRx(2);
    Lxpu=LRx(1);
else
    Rxpu=LRx(2)/Zb;
    Lxpu=LRx(1)*2*pi*frq/Zb;
end;

ks=Vdc*sqrt(3/2)/Vb;     % ma=1/ks for 1pu dc -&gt;1pu ac;

Kp=Kd;</Initialization>
      <MaskParameter Name="cm" Type="checkbox">
        <Prompt>control mode (check VQ/uncheck PQ), only one terminal in VQ mode</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <MaskParameter Name="base" Type="edit">
        <Prompt>base value for power(VA), ac voltage(V), dc voltage to ground(V), and frequenvy(Hz) [Sb, Vb, Vdcb,freq]</Prompt>
        <Value>[Pref, Vac_peak_MV*sqrt(3/2), Vdc/2, fs] </Value>
      </MaskParameter>
      <MaskParameter Name="LRx" Type="edit">
        <Prompt>commutation inductance and resistance [Lx, Rx]</Prompt>
        <Value>[Lac_MV, Rac_MV]</Value>
      </MaskParameter>
      <MaskParameter Name="LRx_inpu" Type="checkbox">
        <Prompt> [Lx, Rx] in pu if checked/ SI unchecked</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <MaskParameter Name="Kd" Type="edit">
        <Prompt>Kp Ki for d-axis PI control [kp ki]</Prompt>
        <Value>[0.3  2]*10/6  %was [1 0.1]   ; [0.1  1]*1 </Value>
      </MaskParameter>
      <MaskParameter Name="Kp" Type="edit" Visible="off">
        <Prompt>Kp Ki for q-axis PI control [kp ki]</Prompt>
        <Value>[0.3 1]*1     %was [1 0.1]   ; [0.1  1]*1   </Value>
      </MaskParameter>
      <MaskParameter Name="Kvdc" Type="edit">
        <Prompt>Kp Ki for Vdc PI control [kp ki]</Prompt>
        <Value>[2 10]*1;   %was [0.5 1]*20 for Cdc=320uF</Value>
      </MaskParameter>
      <MaskParameter Name="Vabc_lim" Type="edit">
        <Prompt>output Vabc limit [min max]</Prompt>
        <Value>[-1 1]</Value>
      </MaskParameter>
      <MaskParameter Name="limitVdq" Type="edit">
        <Prompt>limit for Vd,Vq (pu, default = 1.1)</Prompt>
        <Value>1.1</Value>
      </MaskParameter>
      <MaskParameter Name="nadv" Type="edit">
        <Prompt>nb of time step to compesate for delay (default=1)</Prompt>
        <Value>6</Value>
      </MaskParameter>
      <MaskParameter Name="xtrIctrl1" Type="edit">
        <Prompt>[kp, kp, limitmax, limitmin] for current control (default=[0.4, 10, 10, -10])</Prompt>
        <Value>[0.4 10 10 -10]</Value>
      </MaskParameter>
      <MaskParameter Name="Ts" Type="edit">
        <Prompt>Ts</Prompt>
        <Value>Tctrl</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="TabContainer" Name="ParameterTabContainerVar">
        <DialogControl Type="Tab" Name="ParameterTabVar0">
          <Prompt>parameters</Prompt>
          <DialogControl Type="CheckBox" Name="cm">
            <Prompt>control mode (check VQ/uncheck PQ), only one terminal in VQ mode</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="base">
            <Prompt>base value for power(VA), ac voltage(V), dc voltage to ground(V), and frequenvy(Hz) [Sb, Vb, Vdcb,freq]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="LRx">
            <Prompt>commutation inductance and resistance [Lx, Rx]</Prompt>
          </DialogControl>
          <DialogControl Type="CheckBox" Name="LRx_inpu">
            <Prompt> [Lx, Rx] in pu if checked/ SI unchecked</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Kd">
            <Prompt>Kp Ki for d-axis PI control [kp ki]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Kp">
            <Prompt>Kp Ki for q-axis PI control [kp ki]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Kvdc">
            <Prompt>Kp Ki for Vdc PI control [kp ki]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Vabc_lim">
            <Prompt>output Vabc limit [min max]</Prompt>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="ParameterTabVar01">
          <Prompt>advanced</Prompt>
          <DialogControl Type="Edit" Name="limitVdq">
            <Prompt>limit for Vd,Vq (pu, default = 1.1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="nadv">
            <Prompt>nb of time step to compesate for delay (default=1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="xtrIctrl1">
            <Prompt>[kp, kp, limitmax, limitmin] for current control (default=[0.4, 10, 10, -10])</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Ts">
            <Prompt>Ts</Prompt>
          </DialogControl>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_18637"/>
  </Block>
