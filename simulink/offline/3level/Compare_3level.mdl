    <P Name="Name">PU 
(peak value -&gt;1pu 
SPS convetion)

delVd=idR-iqLw+L(d/dt)id/w0
delVq=iqR+idLw+L(d/dt)iq/w0
#####################
p=(vdid+vqiq)
q=(vqid-vdiq)
=&gt;
Id=(Vd*P+Vq*Q)/C
Iq=(Vq*P-Vd*Q)/C
C=Vd^2+Vq^2</P>
