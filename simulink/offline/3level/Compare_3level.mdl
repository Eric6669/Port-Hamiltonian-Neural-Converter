  <Block BlockType="SubSystem" Name="Model Initialization" SID="18936">
    <PortCounts/>
    <P Name="Position">[787, 353, 1156, 396]</P>
    <P Name="ZOrder">26722</P>
    <P Name="CopyFcn">set_param(gcb,&apos;LinkStatus&apos;,&apos;none&apos;)</P>
    <P Name="FontName">Arial</P>
    <Mask>
      <Type>Model Functions</Type>
      <Display IconUnits="pixels">
text(5, height*0.5, txt, &apos;horizontalAlignment&apos;, &apos;left&apos;, &apos;verticalAlignment&apos;, &apos;middle&apos;) ;
</Display>
      <Initialization>currentBlock = gcb;
root = bdroot(currentBlock);

if ~strcmp(get_param(root,&apos;BlockDiagramType&apos;),&apos;library&apos;)
    if prel==1
        set_param(root, &apos;PreLoadFcn&apos;, InitFcnX);
    else
        set_param(root, &apos;PreLoadFcn&apos;, &apos;&apos;);
    end
    if inif==1
        set_param(root, &apos;InitFcn&apos;, InitFcnX);
    else
        set_param(root, &apos;InitFcn&apos;, &apos;&apos;);
    end
    if strf==1
        set_param(root, &apos;StartFcn&apos;, InitFcnX);
    else
        set_param(root, &apos;StartFcn&apos;, &apos;&apos;);
    end
    if posl==1
        set_param(root, &apos;PostLoadFcn&apos;, InitFcnX);
    else
        set_param(root, &apos;PostLoadFcn&apos;, &apos;&apos;);
    end
end

pos = get_param(currentBlock, &apos;Position&apos;);
width = pos(3) - pos(1); height = pos(4) - pos(2);
txt = [ upper(root) &apos;\n&apos; &apos;- InitFcn. . . . . &apos;  get_param(root, &apos;InitFcn&apos;) ];
</Initialization>
      <MaskParameter Name="InitFcnX" Type="edit" Evaluate="off">
        <Prompt>Initialisation</Prompt>
        <Value>Net_improve_init;L=Lac_MV;Ts=20e-6;Tctrl=Ts;Rac_MV=1;</Value>
      </MaskParameter>
      <MaskParameter Name="prel" Type="checkbox">
        <Prompt>Preload Function</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="posl" Type="checkbox">
        <Prompt>PostLoad Function</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="inif" Type="checkbox">
        <Prompt>InitFcn</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="strf" Type="checkbox">
        <Prompt>StartFcn</Prompt>
        <Value>off</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_18936"/>
  </Block>
