<?xml version="1.0" encoding="utf-8"?>
<chart id="14">
  <P Name="name">MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">14</P>
  <P Name="ssIdHighWaterMark">5</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">phnode_forward</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">14</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dz = phnode_forward(u)
    % =========================================================
    % 0. Persistent variables: load weights only once
    % =========================================================
    persistent W00 b00 W01 b01 W10 b10 W11 b11 W2 b2 p

    if isempty(W00)

        w = coder.load(&apos;3level_pHNODE_weights.mat&apos;);

        % =====================================================
        % R_3level MLP: input 17 -&gt; hidden 16 -&gt; hidden 16 -&gt; output 5
        % Each hidden block: Linear -&gt; LayerNorm -&gt; SiLU
        % =====================================================
        W00 = double(w.R_module_net_0_0_weight);
        b00 = double(w.R_module_net_0_0_bias(:));
        W01 = double(w.R_module_net_0_1_weight(:));
        b01 = double(w.R_module_net_0_1_bias(:));

        W10 = double(w.R_module_net_1_0_weight);
        b10 = double(w.R_module_net_1_0_bias(:));
        W11 = double(w.R_module_net_1_1_weight(:));
        b11 = double(w.R_module_net_1_1_bias(:));

        W2  = double(w.R_module_net_2_weight);
        b2  = double(w.R_module_net_2_bias(:));

        % =====================================================
        % P^{-1}_3level
        % P^{-1} = diag(1/Cp, 1/Cn, 1/La, 1/Lb, 1/Lc)
        % =====================================================
        p_raw = double(w.Pinv_module_p_raw(:));

        base_scale = [
            1/3.3e-3;
            1/3.3e-3;
            1/0.015;
            1/0.015;
            1/0.015
        ];

        p = log(1.0 + exp(p_raw)) .* base_scale;
    end

    % =========================================================
    % 1. Split input vector
    %
    % u = [
    %   z(1:5);
    %   u_ext(1:5);
    %   u_sw(1:12)
    % ]
    %
    % z     = [vcp, vcn, ia, ib, ic]
    % u_ext = [idcp, idcn, ea, eb, ec]
    % u_sw  = [
    %   Sa1, Sa2, Sa3, Sa4,
    %   Sb1, Sb2, Sb3, Sb4,
    %   Sc1, Sc2, Sc3, Sc4
    % ]
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:22));

    % =========================================================
    % 2. Compute dissipation vector R_theta
    % =========================================================
    h = [z; u_sw];

    % ---------------- Block 0 ----------------
    h = W00 * h + b00;

    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);

    h = W01 .* h + b01;
    h = h ./ (1 + exp(-h));     % SiLU

    % ---------------- Block 1 ----------------
    h = W10 * h + b10;

    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);

    h = W11 .* h + b11;
    h = h ./ (1 + exp(-h));     % SiLU

    % ---------------- Output Linear ----------------
    r_out = W2 * h + b2;
    r_full = log(1.0 + exp(r_out));    % Softplus

    % =========================================================
    % 3. Build three-level switching-induced Jz
    %
    % M(s) = [
    %   Sa1*Sa2     Sb1*Sb2     Sc1*Sc2
    %  -Sa3*Sa4    -Sb3*Sb4    -Sc3*Sc4
    % ]
    %
    % J = [ 0   M
    %      -M&apos;  0 ]
    % =========================================================
    Sa1 = u_sw(1);
    Sa2 = u_sw(2);
    Sa3 = u_sw(3);
    Sa4 = u_sw(4);

    Sb1 = u_sw(5);
    Sb2 = u_sw(6);
    Sb3 = u_sw(7);
    Sb4 = u_sw(8);

    Sc1 = u_sw(9);
    Sc2 = u_sw(10);
    Sc3 = u_sw(11);
    Sc4 = u_sw(12);

    ma_p = Sa1 * Sa2;
    mb_p = Sb1 * Sb2;
    mc_p = Sc1 * Sc2;

    ma_n = Sa3 * Sa4;
    mb_n = Sb3 * Sb4;
    mc_n = Sc3 * Sc4;

    Jz = zeros(5, 1, &apos;double&apos;);

    Jz(1) =  ma_p * z(3) + mb_p * z(4) + mc_p * z(5);
    Jz(2) = -ma_n * z(3) - mb_n * z(4) - mc_n * z(5);

    Jz(3) = -ma_p * z(1) + ma_n * z(2);
    Jz(4) = -mb_p * z(1) + mb_n * z(2);
    Jz(5) = -mc_p * z(1) + mc_n * z(2);

    % =========================================================
    % 4. dz/dt = P^{-1} [ Jz - Rz + u_ext ]
    % =========================================================
    rhs = Jz - r_full .* z + u_ext;

    dz = p .* rhs;
end</P>
      </eml>
    </state>
    <data SSID="4" name="u">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dz">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">14</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">14</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

