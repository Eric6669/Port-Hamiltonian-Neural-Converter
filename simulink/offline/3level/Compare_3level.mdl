    % ]
    %
    % J = [ 0   M
    %      -M&apos;  0 ]
    % =========================================================
    Sa1 = u_sw(1);
    Sa2 = u_sw(2);
    Sa3 = u_sw(3);
    Sa4 = u_sw(4);

    Sb1 = u_sw(5);
