    %   u_sw(1:12)
    % ]
    %
    % z     = [vcp, vcn, ia, ib, ic]
    % u_ext = [idcp, idcn, ea, eb, ec]
    % u_sw  = [
    %   Sa1, Sa2, Sa3, Sa4,
    %   Sb1, Sb2, Sb3, Sb4,
    %   Sc1, Sc2, Sc3, Sc4
    % ]
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:22));

    % =========================================================
    % 2. Compute dissipation vector R_theta
    % =========================================================
    h = [z; u_sw];

    % ---------------- Block 0 ----------------
    h = W00 * h + b00;

    mu = mean(h);
