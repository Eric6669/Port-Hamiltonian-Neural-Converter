        % P^{-1} = diag(1/Cp, 1/Cn, 1/La, 1/Lb, 1/Lc)
        % =====================================================
        p_raw = double(w.Pinv_module_p_raw(:));

        base_scale = [
            1/3.3e-3;
            1/3.3e-3;
            1/0.015;
            1/0.015;
            1/0.015
