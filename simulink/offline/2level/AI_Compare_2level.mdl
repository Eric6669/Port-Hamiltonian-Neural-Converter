__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_42.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="42">
  <P Name="name">MATLAB Function5</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">42</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">5</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">lstm_forward</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">42</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function z_next = lstm_forward(u)
    % =========================================================
    % LSTM forward: 2-layer LSTM, hidden_dim = 128
    % Input : [z(5); u_ext(5); u_sw(6)]
    % Output: z_next(5)
    %
    % PyTorch LSTM gate order:
    %   gates = [input; forget; cell; output]
    %         = [i; f; g; o]
    % =========================================================

    persistent Wih0 Whh0 bih0 bhh0 ...
               Wih1 Whh1 bih1 bhh1 ...
               Wout bout ...
               h0 c0 h1 c1

    if isempty(Wih0)
        w = coder.load(&apos;2level_LSTM_weights.mat&apos;);

        % Layer 0
        Wih0 = double(w.lstm_weight_ih_l0);
        Whh0 = double(w.lstm_weight_hh_l0);
        bih0 = double(w.lstm_bias_ih_l0(:));
        bhh0 = double(w.lstm_bias_hh_l0(:));

        % Layer 1
        Wih1 = double(w.lstm_weight_ih_l1);
        Whh1 = double(w.lstm_weight_hh_l1);
        bih1 = double(w.lstm_bias_ih_l1(:));
        bhh1 = double(w.lstm_bias_hh_l1(:));

        % Output Linear
        Wout = double(w.out_weight);
        bout = double(w.out_bias(:));

        % Hidden and cell states
        h0 = zeros(128, 1, &apos;double&apos;);
        c0 = zeros(128, 1, &apos;double&apos;);
        h1 = zeros(128, 1, &apos;double&apos;);
        c1 = zeros(128, 1, &apos;double&apos;);
    end

    % =========================================================
    % 1. 拆解输入
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:16));

    x = [z; u_ext; u_sw];   % 16 x 1

    % =========================================================
    % 2. LSTM Layer 0
    % =========================================================
    gates0 = Wih0 * x + bih0 + Whh0 * h0 + bhh0;

    i0 = sigmoid_local(gates0(1:128));
    f0 = sigmoid_local(gates0(129:256));
    g0 = tanh(gates0(257:384));
    o0 = sigmoid_local(gates0(385:512));

    c0 = f0 .* c0 + i0 .* g0;
    h0 = o0 .* tanh(c0);

    % =========================================================
    % 3. LSTM Layer 1
    % =========================================================
    gates1 = Wih1 * h0 + bih1 + Whh1 * h1 + bhh1;

    i1 = sigmoid_local(gates1(1:128));
    f1 = sigmoid_local(gates1(129:256));
    g1 = tanh(gates1(257:384));
    o1 = sigmoid_local(gates1(385:512));

    c1 = f1 .* c1 + i1 .* g1;
    h1 = o1 .* tanh(c1);

    % =========================================================
    % 4. Output Linear
    % =========================================================
    z_next = Wout * h1 + bout;
end


function y = sigmoid_local(x)
    y = 1 ./ (1 + exp(-x));
end</P>
      </eml>
    </state>
    <data SSID="4" name="u">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="z_next">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">42</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
