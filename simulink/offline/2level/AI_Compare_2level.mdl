        <P Name="isEML">1</P>
        <P Name="script">function dz = pinode_forward(u)
    % =========================================================
    % PINODE forward: 3-layer MLP, hidden_dim = 64
    % Inference is identical to NODE.
    % Input : [z(5); u_ext(5); u_sw(6)]
    % Output: dz(5)
    % =========================================================

    persistent W00 b00 W01 b01 ...
               W10 b10 W11 b11 ...
               W20 b20 W21 b21 ...
               W3 b3

    if isempty(W00)
        w = coder.load(&apos;2level_PINODE_weights.mat&apos;);

        % Block 0: Linear + LayerNorm + SiLU
        W00 = double(w.net_0_0_weight);
        b00 = double(w.net_0_0_bias(:));
        W01 = double(w.net_0_1_weight(:));
        b01 = double(w.net_0_1_bias(:));

        % Block 1: Linear + LayerNorm + SiLU
        W10 = double(w.net_1_0_weight);
        b10 = double(w.net_1_0_bias(:));
        W11 = double(w.net_1_1_weight(:));
        b11 = double(w.net_1_1_bias(:));

        % Block 2: Linear + LayerNorm + SiLU
        W20 = double(w.net_2_0_weight);
        b20 = double(w.net_2_0_bias(:));
        W21 = double(w.net_2_1_weight(:));
        b21 = double(w.net_2_1_bias(:));

        % Output Linear
        W3 = double(w.net_3_weight);
        b3 = double(w.net_3_bias(:));
    end

    % =========================================================
    % 1. 拆解输入
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:16));

    h = [z; u_ext; u_sw];

    % =========================================================
    % 2. MLP forward
    % =========================================================

    % --- Block 0 ---
    h = W00 * h + b00;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W01 .* h + b01;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Block 1 ---
    h = W10 * h + b10;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W11 .* h + b11;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Block 2 ---
    h = W20 * h + b20;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W21 .* h + b21;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Output Linear ---
    dz = W3 * h + b3;
end</P>
      </eml>
    </state>
    <data SSID="4" name="u">
