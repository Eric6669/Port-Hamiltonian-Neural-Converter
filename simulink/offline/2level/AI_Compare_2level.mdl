<?xml version="1.0" encoding="utf-8"?>
<chart id="49">
  <P Name="name">MATLAB Function6</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">49</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">5</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">pinode_forward</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">49</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dz = pinode_forward(u)
    % =========================================================
    % PINODE forward: 3-layer MLP, hidden_dim = 64
    % Inference is identical to NODE.
    % Input : [z(5); u_ext(5); u_sw(6)]
    % Output: dz(5)
    % =========================================================

    persistent W00 b00 W01 b01 ...
               W10 b10 W11 b11 ...
               W20 b20 W21 b21 ...
               W3 b3

    if isempty(W00)
        w = coder.load(&apos;2level_PINODE_weights.mat&apos;);

        % Block 0: Linear + LayerNorm + SiLU
        W00 = double(w.net_0_0_weight);
        b00 = double(w.net_0_0_bias(:));
        W01 = double(w.net_0_1_weight(:));
        b01 = double(w.net_0_1_bias(:));

        % Block 1: Linear + LayerNorm + SiLU
        W10 = double(w.net_1_0_weight);
        b10 = double(w.net_1_0_bias(:));
        W11 = double(w.net_1_1_weight(:));
        b11 = double(w.net_1_1_bias(:));

        % Block 2: Linear + LayerNorm + SiLU
        W20 = double(w.net_2_0_weight);
        b20 = double(w.net_2_0_bias(:));
        W21 = double(w.net_2_1_weight(:));
        b21 = double(w.net_2_1_bias(:));

        % Output Linear
        W3 = double(w.net_3_weight);
        b3 = double(w.net_3_bias(:));
    end

    % =========================================================
    % 1. 拆解输入
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:16));

    h = [z; u_ext; u_sw];

    % =========================================================
    % 2. MLP forward
    % =========================================================

    % --- Block 0 ---
    h = W00 * h + b00;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W01 .* h + b01;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Block 1 ---
    h = W10 * h + b10;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W11 .* h + b11;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Block 2 ---
    h = W20 * h + b20;
    mu = mean(h);
    var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W21 .* h + b21;
    h = h ./ (1 + exp(-h));   % SiLU

    % --- Output Linear ---
    dz = W3 * h + b3;
end</P>
      </eml>
    </state>
    <data SSID="4" name="u">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dz">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">49</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">49</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

