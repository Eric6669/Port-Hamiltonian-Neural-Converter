<?xml version="1.0" encoding="utf-8"?>
<chart id="14">
  <P Name="name">MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">14</P>
  <P Name="ssIdHighWaterMark">5</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">phnode_forward</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">14</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dz = phnode_forward(u)
    % =========================================================
    % 0. 声明持久化变量 (仅在 t=0 时加载和计算一次)
    % =========================================================
    persistent W00 b00 W01 b01 W10 b10 W11 b11 W20 b20 W21 b21 W3 b3 p
    
    if isempty(W00)

        w = coder.load(&apos;2level_pHNODE_weights.mat&apos;);
        
        W00 = double(w.R_module_net_0_0_weight); b00 = double(w.R_module_net_0_0_bias(:));
        W01 = double(w.R_module_net_0_1_weight(:)); b01 = double(w.R_module_net_0_1_bias(:));
        
        W10 = double(w.R_module_net_1_0_weight); b10 = double(w.R_module_net_1_0_bias(:));
        W11 = double(w.R_module_net_1_1_weight(:)); b11 = double(w.R_module_net_1_1_bias(:));
        
        W20 = double(w.R_module_net_2_0_weight); b20 = double(w.R_module_net_2_0_bias(:));
        W21 = double(w.R_module_net_2_1_weight(:)); b21 = double(w.R_module_net_2_1_bias(:));
        
        W3  = double(w.R_module_net_3_weight);   b3  = double(w.R_module_net_3_bias(:));

        p_raw = double(w.Pinv_module_p_raw(:));
        base_scale = [1/3.3e-3; 1/3.3e-3; 1/0.015; 1/0.015; 1/0.015];
        p = log(1.0 + exp(p_raw)) .* base_scale;
    end
    
    % =========================================================
    % 1. 拆解输入向量
    % =========================================================
    z     = double(u(1:5));
    u_ext = double(u(6:10));
    u_sw  = double(u(11:16));
    
    % =========================================================
    % 2. 构造耗散矩阵 R
    % =========================================================
    h = [z; u_sw];
    
    % --- Block 0 ---
    h = W00 * h + b00;
    mu = mean(h); var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W01 .* h + b01;
    h = h ./ (1 + exp(-h)); % SiLU
    
    % --- Block 1 ---    
    h = W10 * h + b10;
    mu = mean(h); var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W11 .* h + b11;
    h = h ./ (1 + exp(-h));
    
    % --- Block 2 ---
    h = W20 * h + b20;
    mu = mean(h); var_h = mean((h - mu).^2);
    h = (h - mu) ./ sqrt(var_h + 1e-5);
    h = W21 .* h + b21;
    h = h ./ (1 + exp(-h));
    
    % --- Output Linear ---
    r_out = W3 * h + b3;   
    r_full = log(1 + exp(r_out)); 
    
    % =========================================================
    % 3. 计算最终输出 dz 稀疏运算
    % =========================================================
    Jz = zeros(5, 1, &apos;double&apos;);
    Jz(1) =  u_sw(1)*z(3) + u_sw(3)*z(4) + u_sw(5)*z(5);
    Jz(2) = -u_sw(2)*z(3) - u_sw(4)*z(4) - u_sw(6)*z(5);
    Jz(3) = -u_sw(1)*z(1) + u_sw(2)*z(2);
    Jz(4) = -u_sw(3)*z(1) + u_sw(4)*z(2);
    Jz(5) = -u_sw(5)*z(1) + u_sw(6)*z(2);
 
    rhs = Jz - r_full .* z + u_ext;
 
    dz = p .* rhs;
end</P>
      </eml>
    </state>
    <data SSID="4" name="u">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dz">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">14</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">14</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

